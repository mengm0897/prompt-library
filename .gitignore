!/app/
/app/*
!/app/server.py
!/app/md_store.py
!/app/web/
/app/web/*
!/app/web/index.html
!/app/web/app.js
!/app/web/markdown.js
!/app/web/style.css
!/app/web/reader.css
!/app/web/taxonomy.css
!/app/web/attachments.css

!/examples/
/examples/*
!/examples/0001.md
!/examples/0002.md

!/tests/
/tests/*
!/tests/md_smoke.py
!/tests/smoke.py
